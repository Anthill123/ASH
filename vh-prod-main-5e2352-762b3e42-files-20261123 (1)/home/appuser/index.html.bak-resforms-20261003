      // === CONTACT FORM SUBMISSION ===
      function submitForm(e) {
        e.preventDefault();
        var btn = document.getElementById('form-submit-btn');
        var okBox = document.getElementById('formSuccess');
        var errBox = document.getElementById('formError');
        var name = document.getElementById('fname').value;
        var phone = document.getElementById('fphone').value;
        var email = document.getElementById('femail').value;
        var service = [].slice.call(document.querySelectorAll('.cf-service:checked')).map(function (c) { return c.value; }).join(', ');
        var message = document.getElementById('fmessage').value;

        errBox.style.display = 'none';
        okBox.style.display = 'none';
        btn.disabled = true;
        btn.textContent = 'Sending...';

        fetch('https://formsubmit.co/ajax/contact@ash-financial.com', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            _subject: 'New Consultation Request from ' + name,
            _template: 'table',
            _captcha: 'false',
            Name: name,
            Phone: phone,
            Email: email,
            Service: service || 'Not specified',
            Message: message || '(no message)'
          })
        })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
        .then(function (res) {
          if (!res.ok || res.data.success === 'false' || res.data.success === false) {
            throw new Error(res.data.message || 'Send failed');
          }
          okBox.style.display = 'block';
          document.getElementById('contactForm').reset();
          [].slice.call(document.querySelectorAll('#fserviceGroup .chip')).forEach(function (l) { l.classList.remove('selected'); });
        })
        .catch(function () {
          errBox.innerHTML = '⚠️ Something went wrong sending your message. Please email us directly at <a href="mailto:contact@ash-financial.com?subject=Financial%20Consultation%20Inquiry" style="color:#fff;text-decoration:underline;">contact@ash-financial.com</a>.';
          errBox.style.display = 'block';
        })
        .finally(function () {
          btn.disabled = false;
          btn.textContent = 'Send Message';
        });
      }

      // === HERO: START INTAKE ===
      (function () {
        var hb = document.getElementById('hero-intake-btn');
        if (hb) {
          hb.addEventListener('click', function (e) {
            e.preventDefault();
            document.getElementById('intake').scrollIntoView({ behavior: 'smooth' });
