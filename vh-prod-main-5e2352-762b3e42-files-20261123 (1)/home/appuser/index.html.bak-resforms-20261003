      // === INTERSECTION OBSERVER: FADE IN SECTIONS ===
      var fadeSections = document.querySelectorAll('.fade-section');
      var observerOptions = {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px'
      };

      var sectionObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry, index) {
          if (entry.isIntersecting) {
            // Stagger animation
            setTimeout(function() {
              entry.target.classList.add('visible');
            }, index * 150);
            sectionObserver.unobserve(entry.target);
          }
        });
      }, observerOptions);

      fadeSections.forEach(function(section) {
        sectionObserver.observe(section);
      });

      // === FOOTER EMAIL & PHONE HOVER ===
      var footerEmail1 = document.getElementById('footer-email-1');
      var footerPhone = document.getElementById('footer-phone');

      if (footerEmail1) {
        footerEmail1.addEventListener('mouseover', function() { this.style.color = '#C8102E'; });
