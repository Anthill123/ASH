        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #444;
        text-decoration: none;
        transition: color 0.2s;
        cursor: pointer;
      }
      .nav-link:hover { color: var(--brand); }

      /* LOGO */
      .logo-bar-top {
        width: 40px; height: 3px;
        background: #0a0a0a;
        margin-bottom: 2px;
      }
      .logo-text-ash {
        font-family: 'Montserrat', sans-serif;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: 4px;
        color: #0a0a0a;
        line-height: 1;
      }
      .logo-red-bars {
        display: flex;
        justify-content: space-between;
        width: 40px;
        margin-top: 1px;
      }
      .logo-red-bar {
        width: 14px; height: 2px;
        background: var(--brand);
      }
      .logo-financial {
        font-family: 'Montserrat', sans-serif;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 3.5px;
        text-transform: uppercase;
        color: #0a0a0a;
        margin-top: 1px;
      }

      /* HERO */
      .hero-section {
        min-height: 100vh;
        background-color: #0a0a0a;
        background-image: repeating-linear-gradient(
          45deg,
          transparent,
          transparent 35px,
          rgba(255,255,255,0.015) 35px,
          rgba(255,255,255,0.015) 36px
        );
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        position: relative;
      }

      .hero-content {
        animation: heroFadeIn 1.2s ease forwards;
        opacity: 0;
      }
      @keyframes heroFadeIn {
        to { opacity: 1; transform: translateY(0); }
        from { opacity: 0; transform: translateY(20px); }
      }

      .btn-primary {
        display: inline-block;
        background: var(--brand);
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 15px 34px;
        border: 2px solid var(--brand);
        border-radius: 2px;
        cursor: pointer;
        transition: all 0.25s ease;
        text-decoration: none;
      }
      .btn-primary:hover {
        background: var(--brand-dark);
        border-color: var(--brand-dark);
      }

      /* BTN-RED */
      .btn-red {
        background: #C8102E;
        color: #fff;
        padding: 14px 34px;
        border: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s;
        text-decoration: none;
        display: inline-block;
      }
      .btn-red:hover {
        background: #a00d24;
      }

      /* BTN-OUTLINE */
      .btn-outline {
        background: transparent;
        color: #fff;
        padding: 14px 34px;
        border: 2px solid #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
      }
      .btn-outline:hover {
        background: #fff;
        color: #0a0a0a;
      }

      /* BTN-WHITE */
      .btn-white {
        background: transparent;
        color: #fff;
        padding: 14px 40px;
        border: 2px solid #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
      }
      .btn-white:hover {
        background: #fff;
        color: #C8102E;
      }

      /* SECTION FADE-IN */
      .fade-section {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease, transform 0.7s ease;
      }
      .fade-section.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* SERVICE CARD */
      .service-card {
        background: #fff;
        border-top: 3px solid var(--brand);
        padding: 28px;
        border-radius: 4px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }
      .service-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 28px rgba(0,0,0,0.13);
      }

      /* BOOK COVER */
      .book-cover {
        width: 180px;
        height: 270px;
        border-radius: 3px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px;
        flex-shrink: 0;
        position: relative;
      }

      /* MOBILE MENU */
      .mobile-menu {
        position: fixed;
        inset: 0;
        background: #fff;
        z-index: 9999;
        display: none;
        flex-direction: column;
        padding: 24px;
      }
      .mobile-menu.open {
        display: flex;
      }
      .mobile-menu .nav-link {
        font-size: 18px;
        padding: 16px 0;
        border-bottom: 1px solid #eee;
      }

      /* CTA */
      .btn-outline-white {
        display: inline-block;
        background: transparent;
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 15px 40px;
        border: 2px solid #fff;
        border-radius: 2px;
        cursor: pointer;
        transition: all 0.25s ease;
        text-decoration: none;
      }
      .btn-outline-white:hover {
        background: #fff;
        color: var(--brand);
      }

      /* VALUE CARD */
      .value-card {
        padding: 20px 0;
      }
      .value-card-bar {
        width: 30px; height: 3px;
        background: var(--brand);
        margin-bottom: 12px;
      }

      /* FOOTER LINK */
      .footer-link {
        color: #ccc;
        text-decoration: none;
        font-size: 13px;
        transition: color 0.2s;
        display: block;
        padding: 3px 0;
        cursor: pointer;
      }
      .footer-link:hover { color: var(--brand); }

      /* SECTION LABELS */
      .section-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--brand);
        margin-bottom: 14px;
      }

      /* CONTACT SECTION */
      #contact { background: #C8102E; padding: 80px 60px; }
      .contact-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
      .contact-left h2 { font-family: 'Montserrat', sans-serif; font-size: 32px; font-weight: 800; color: #fff; margin: 14px 0 16px; line-height: 1.2; }
      .contact-left p { font-size: 15px; color: rgba(255,255,255,0.8); line-height: 1.8; margin-bottom: 30px; }
      .contact-info { display: flex; flex-direction: column; gap: 14px; }
      .contact-info-item { display: flex; flex-direction: column; }
      .contact-info-label { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 3px; }
      .contact-info-item a, .contact-info-item span { font-size: 14px; color: #fff; text-decoration: none; }
      .contact-info-item a:hover { text-decoration: underline; }
      .contact-right { background: #fff; padding: 40px; border-radius: 2px; }
      .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      /* === INTAKE WIZARD + SERVICE CHIPS === */
      .intake-card { background:#fff; border:1px solid #e6e6e6; border-top:3px solid #C8102E; padding:34px 30px; }
      .intake-step { display:none; }
      .intake-step.active { display:block; }
      .intake-q { font-family:'Montserrat',sans-serif; font-size:13px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#0a0a0a; margin-bottom:6px; }
      .intake-hint { font-family:'Inter',sans-serif; font-size:13px; color:#777; margin-bottom:16px; line-height:1.6; }
      .chip-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:10px; }
      .chip-grid.tight { grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); }
      .chip { display:flex; align-items:center; gap:11px; border:1px solid #ddd; background:#fafafa; padding:13px 15px; cursor:pointer; border-radius:2px; transition:border-color .18s, background .18s, box-shadow .18s; font-family:'Inter',sans-serif; font-size:14px; color:#222; line-height:1.4; -webkit-user-select:none; user-select:none; }
      .chip:hover { border-color:#C8102E; background:#fff; }
      .chip input { position:absolute; opacity:0; width:0; height:0; }
      .chip .chip-box { width:17px; height:17px; border:1px solid #bbb; border-radius:2px; flex-shrink:0; position:relative; background:#fff; transition:background .18s, border-color .18s; }
      .chip.selected { border-color:#C8102E; background:#fff; box-shadow:inset 0 0 0 1px #C8102E; }
      .chip.selected .chip-box { background:#C8102E; border-color:#C8102E; }
      .chip.selected .chip-box:after { content:''; position:absolute; left:5px; top:1px; width:5px; height:10px; border:solid #fff; border-width:0 2px 2px 0; transform:rotate(45deg); }
      .chip input:focus-visible + .chip-box { outline:2px solid #C8102E; outline-offset:2px; }
      .chip-primary { font-weight:600; }
      .intake-bar { height:3px; background:#eee; margin-bottom:10px; }
      .intake-bar-fill { height:3px; background:#C8102E; width:20%; transition:width .3s ease; }
      .intake-meta { font-family:'Montserrat',sans-serif; font-size:11px; font-weight:700; letter-spacing:1.5px; color:#999; margin-bottom:24px; text-transform:uppercase; }
      .intake-nav { display:flex; justify-content:space-between; gap:12px; margin-top:28px; }
      .intake-btn { font-family:'Montserrat',sans-serif; font-size:12px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:14px 30px; border:none; cursor:pointer; border-radius:2px; transition:background .2s, color .2s, border-color .2s; }
      .intake-btn:disabled { opacity:.55; cursor:default; }
      .intake-next { background:#C8102E; color:#fff; margin-left:auto; }
      .intake-next:hover:not(:disabled) { background:#a50d26; }
      .intake-back { background:transparent; color:#666; border:1px solid #ddd; }
      .intake-back:hover { border-color:#999; color:#111; }
      .ik-detail { border-left:2px solid #f0f0f0; padding-left:20px; margin-bottom:26px; }
      .ik-detail-title { font-family:'Montserrat',sans-serif; font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:#C8102E; margin-bottom:14px; }
      .intake-review { background:#fafafa; border:1px solid #eee; padding:20px; font-family:'Inter',sans-serif; font-size:13.5px; color:#333; line-height:1.7; }
      .intake-review .rv-k { font-family:'Montserrat',sans-serif; font-size:10px; letter-spacing:1.2px; text-transform:uppercase; color:#999; display:block; margin-top:12px; }
      .intake-review .rv-k:first-child { margin-top:0; }
      .intake-msg { margin-top:18px; padding:14px 16px; font-size:13.5px; border-radius:2px; display:none; font-family:'Inter',sans-serif; line-height:1.6; }
      .intake-err { background:#fdecee; color:#8f0a1f; border:1px solid #f3c2ca; }
      .intake-done { background:#0a0a0a; border-top:3px solid #C8102E; padding:52px 30px; text-align:center; display:none; }
      @media (max-width:640px) { .intake-card { padding:24px 18px; } .intake-btn { padding:13px 20px; font-size:11px; } }
      /* === WIZARD HOSTED INSIDE THE CONTACT PANEL === */
      .contact-inner { grid-template-columns: 0.85fr 1.15fr; gap: 60px; }
      .contact-right .intake-card { border:0; padding:0; background:transparent; }
      .contact-right .intake-done { padding:40px 24px; }
      .quick-msg-wrap { margin-top:26px; padding-top:20px; border-top:1px solid #eee; text-align:center; }
      .quick-msg-link { font-family:'Inter',sans-serif; font-size:13.5px; color:#777; text-decoration:underline; cursor:pointer; display:inline-block; }
      .quick-msg-link:hover { color:#C8102E; }
      .quick-msg-body { margin-top:22px; }
      .form-group { display: flex; flex-direction: column; margin-bottom: 18px; }
      .form-group label { font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #333; margin-bottom: 7px; font-family: 'Montserrat', sans-serif; }
      .form-group input, .form-group select, .form-group textarea { border: 1px solid #ddd; padding: 11px 14px; font-size: 14px; font-family: 'Inter', sans-serif; color: #111; outline: none; border-radius: 2px; transition: border-color 0.2s; background: #fafafa; }
      .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: #C8102E; background: #fff; }
      .form-group textarea { resize: vertical; }
      .form-submit { width: 100%; background: #C8102E; color: #fff; border: none; padding: 14px; font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; transition: background 0.2s; }
      .form-submit:hover { background: #a00d24; }

      /* COMING SOON BADGE */
      .badge-coming-soon {
        display: inline-block;
        background: transparent;
        border: 2px solid #c9a84c;
        color: #c9a84c;
        padding: 10px 24px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-top: 10px;
      }

      /* COMPANION (SUPPLEMENTAL) EDITION — not a numbered main title */
      .companion-divider { max-width: 900px; margin: 58px auto 30px; display: flex; align-items: center; gap: 16px; }
      .companion-divider::before, .companion-divider::after { content: ""; flex: 1; height: 1px; background: rgba(201,168,76,0.35); }
      .companion-divider span { font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 2px; color: #c9a84c; text-transform: uppercase; white-space: nowrap; }
      .companion-wrap { max-width: 560px; margin: 0 auto; }
      .companion-cover { width: 155px; height: 232px; padding: 16px; border-left: 3px solid #c9a84c; }
      @media (max-width: 600px) {
        .companion-divider { gap: 12px; }
        .companion-divider span { font-size: 9px; letter-spacing: 1px; white-space: normal; text-align: center; }
      }

      /* BOOKS GRID */
      .books-grid {
        max-width: 900px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 50px;
        justify-items: center;
      }
      @media (max-width: 768px) {
        .books-grid {
          grid-template-columns: 1fr;
        }
      }

      /* BOOK FEATURE CHIPS */
      .book-feats { list-style: none; padding: 0; margin: 0 0 12px; display: flex; flex-wrap: wrap; gap: 6px 8px; justify-content: center; }
      .book-feats li { font-family: 'Inter', sans-serif; font-size: 11.5px; color: #ddd; background: rgba(201,168,76,0.08); border: 1px solid rgba(201,168,76,0.28); border-radius: 999px; padding: 4px 10px; }
      .book-bestfor { font-family: 'Inter', sans-serif; font-size: 12px; color: #999; line-height: 1.6; margin-bottom: 14px; }
      .book-bestfor strong { color: #c9a84c; font-weight: 700; }
      @media (min-width: 640px) { .book-feats { justify-content: flex-start; } }

      /* BOOKS SUB-HEADINGS / PANELS */
      .books-subhead { font-family: 'Montserrat', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 2px; color: #c9a84c; text-transform: uppercase; text-align: center; margin: 0 0 22px; }
      .dark-panel { background: rgba(255,255,255,0.03); border: 1px solid rgba(201,168,76,0.25); border-radius: 6px; padding: 26px; }
      .dark-panel ul { list-style: none; padding: 0; margin: 0; }
      .dark-panel ul li { font-family: 'Inter', sans-serif; font-size: 13px; color: #bbb; line-height: 1.6; padding-left: 16px; position: relative; margin-bottom: 7px; }
      .dark-panel ul li::before { content: "\2022"; position: absolute; left: 0; color: #C8102E; }
      .start-grid { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
      @media (max-width: 768px) { .start-grid { grid-template-columns: 1fr; } }

      /* COMING SOON GRID */
      .soon-grid { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; justify-items: center; }
      @media (max-width: 768px) { .soon-grid { grid-template-columns: 1fr; max-width: 340px; } }
      .soon-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(201,168,76,0.25); border-radius: 6px; padding: 22px 16px; text-align: center; width: 100%; }
      .soon-cover { width: 140px; height: 210px; padding: 14px; margin: 0 auto 16px; }

      @media (max-width: 900px) { .contact-inner { grid-template-columns: 1fr; gap: 40px; } .form-row { grid-template-columns: 1fr; } }
      @media (max-width: 600px) { #contact { padding: 60px 24px; } .contact-right { padding: 24px; } }
    </style>
</head>
