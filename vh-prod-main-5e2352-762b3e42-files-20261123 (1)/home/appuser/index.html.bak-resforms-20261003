      })();

      // === CHIP VISUAL STATE (intake + contact form) ===
      function ashSyncChip(inp) {
        if (inp.type === 'radio' && inp.name) {
          [].slice.call(document.querySelectorAll('.chip input[name="' + inp.name + '"]')).forEach(function (o) {
            var l = o.closest('.chip');
            if (l) { l.classList.toggle('selected', o.checked); }
          });
        } else {
          var lab = inp.closest('.chip');
          if (lab) { lab.classList.toggle('selected', inp.checked); }
        }
      }
      [].slice.call(document.querySelectorAll('.chip input')).forEach(function (inp) {
        inp.addEventListener('change', function () { ashSyncChip(inp); });
      });

      // === CLIENT INTAKE WIZARD ===
      (function () {
        var root = document.getElementById('intake');
        if (!root) { return; }

        var KEY = 'ashIntakeV1';
        var TITLES = ['What you need', 'Who it is for', 'The details', 'Goals and timing', 'Contact and review'];
        var steps = [].slice.call(root.querySelectorAll('.intake-step'));
        var barFill = document.getElementById('intakeBarFill');
        var meta = document.getElementById('intakeMeta');
        var backBtn = document.getElementById('intakeBack');
        var nextBtn = document.getElementById('intakeNext');
        var errBox = document.getElementById('intakeError');
        var card = document.getElementById('intakeCard');
        var doneBox = document.getElementById('intakeDone');
        var reviewBox = document.getElementById('intakeReview');
        var cur = 0;
        var sending = false;

        function all(sel) { return [].slice.call(root.querySelectorAll(sel)); }
        function val(id) { var e = document.getElementById(id); return e ? String(e.value).trim() : ''; }
        function radio(name) { var e = root.querySelector('input[name="' + name + '"]:checked'); return e ? e.value : ''; }
        function checks(cls) { return all('.' + cls + ':checked').map(function (c) { return c.value; }).join(', '); }
        function services() { return all('.ik-service:checked').map(function (c) { return c.value; }); }
        function detailKeys() {
          return all('.ik-service:checked').map(function (c) { return c.getAttribute('data-key'); })
            .filter(function (k) { return !!document.getElementById('ik-detail-' + k); });
        }
        function hasDetails() { return detailKeys().length > 0; }
        function showErr(m) { errBox.textContent = m; errBox.style.display = 'block'; }
        function hideErr() { errBox.style.display = 'none'; }

        function paintDetails() {
          var keys = detailKeys();
          all('.ik-detail').forEach(function (d) { d.style.display = 'none'; });
          keys.forEach(function (k) {
            var d = document.getElementById('ik-detail-' + k);
            if (d) { d.style.display = 'block'; }
          });
        }

        function collect() {
          var out = [];
          var keys = detailKeys();
          function add(k, v) { if (v) { out.push([k, v]); } }
          add('Services Requested', services().join(', '));
          add('Client Type', radio('ikWho'));
          if (keys.indexOf('taxprep') > -1) {
            add('Tax Prep · Years Needed', val('ikTpYears'));
            add('Tax Prep · Filing Status', radio('ikTpStatus'));
            add('Tax Prep · Income Documents', checks('ik-tp-docs'));
            add('Tax Prep · Filed Last Year', radio('ikTpLast'));
          }
          if (keys.indexOf('taxplanning') > -1) {
            add('Tax Planning · Entity Type', radio('ikPlEntity'));
            add('Tax Planning · Expected Income', val('ikPlIncome'));
            add('Tax Planning · Prior-Year Surprise', radio('ikPlSurprise'));
          }
          if (keys.indexOf('bookkeeping') > -1) {
            add('Bookkeeping · Software In Use', radio('ikBkSoft'));
            add('Bookkeeping · Monthly Volume', val('ikBkVol'));
            add('Bookkeeping · How Far Behind', radio('ikBkBehind'));
          }
          if (keys.indexOf('finplanning') > -1) {
            add('Financial Planning · Goals', checks('ik-fp-goals'));
            add('Financial Planning · Timeline', radio('ikFpTime'));
          }
          add('Desired Outcome', val('ikGoals'));
          add('Start Timeline', radio('ikUrgency'));
          add('Additional Notes', val('ikNotes'));
          add('Name', val('ikName'));
          add('Email', val('ikEmail'));
          add('Phone', val('ikPhone'));
          add('Preferred Contact Method', radio('ikPref'));
          return out;
        }

        function esc(s) {
          return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function paintReview() {
          var rows = collect().filter(function (r) {
            return ['Name', 'Email', 'Phone', 'Preferred Contact Method'].indexOf(r[0]) === -1;
          });
          if (!rows.length) { reviewBox.innerHTML = '<span style="color:#888;">Nothing entered yet.</span>'; return; }
          reviewBox.innerHTML = rows.map(function (r) {
            return '<span class="rv-k">' + esc(r[0]) + '</span>' + esc(r[1]);
          }).join('');
        }

        function validate(i) {
          if (i === 0 && services().length === 0) { showErr('Pick at least one service to continue.'); return false; }
          if (i === 1 && !radio('ikWho')) { showErr('Let us know who this is for.'); return false; }
          if (i === 4) {
            if (!val('ikName')) { showErr('Please enter your name.'); return false; }
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val('ikEmail'))) { showErr('Please enter a valid email address.'); return false; }
            if (!val('ikPhone')) { showErr('Please enter a phone number.'); return false; }
          }
          return true;
        }

        function render() {
          steps.forEach(function (s, i) { s.classList.toggle('active', i === cur); });
          barFill.style.width = ((cur + 1) / steps.length * 100) + '%';
          meta.innerHTML = 'Step ' + (cur + 1) + ' of ' + steps.length + ' &middot; ' + TITLES[cur];
          backBtn.style.visibility = cur === 0 ? 'hidden' : 'visible';
          nextBtn.textContent = cur === steps.length - 1 ? 'Submit Intake' : 'Continue';
          if (cur === 2) { paintDetails(); }
          if (cur === 4) { paintReview(); }
          hideErr();
        }

        function save() {
          try {
            var d = { step: cur, fields: {}, radios: {}, boxes: [] };
            all('input[type="text"], input[type="tel"], input[type="email"], textarea, select').forEach(function (e) {
              if (e.id) { d.fields[e.id] = e.value; }
            });
            all('input[type="radio"]:checked').forEach(function (e) { d.radios[e.name] = e.value; });
            all('input[type="checkbox"]:checked').forEach(function (e) { d.boxes.push(e.className + '|' + e.value); });
            localStorage.setItem(KEY, JSON.stringify(d));
          } catch (err) { /* storage unavailable — not fatal */ }
        }

        function restore() {
          try {
            var raw = localStorage.getItem(KEY);
            if (!raw) { return; }
            var d = JSON.parse(raw);
            Object.keys(d.fields || {}).forEach(function (id) {
              var e = document.getElementById(id);
              if (e) { e.value = d.fields[id]; }
            });
            Object.keys(d.radios || {}).forEach(function (n) {
              var e = root.querySelector('input[name="' + n + '"][value="' + d.radios[n].replace(/"/g, '\\"') + '"]');
              if (e) { e.checked = true; ashSyncChip(e); }
            });
            (d.boxes || []).forEach(function (sig) {
              var p = sig.split('|');
              var cls = p.shift();
              var v = p.join('|');
              all('input[type="checkbox"]').forEach(function (e) {
                if (e.className === cls && e.value === v) { e.checked = true; ashSyncChip(e); }
              });
            });
            if (typeof d.step === 'number' && d.step >= 0 && d.step < steps.length) { cur = d.step; }
          } catch (err) { /* corrupt draft — start clean */ }
        }

        function submit() {
          if (sending) { return; }
          sending = true;
          nextBtn.disabled = true;
          nextBtn.textContent = 'Sending...';
          hideErr();

          var rows = collect();
          var payload = {
            _subject: 'New Client Intake — ' + val('ikName') + ' — ' + (services().join(', ') || 'no service selected'),
            _template: 'table',
            _captcha: 'false'
          };
          rows.forEach(function (r) { payload[r[0]] = r[1]; });
          payload['Submitted Via'] = 'Client Intake wizard (ash-financial.com)';

          fetch('https://formsubmit.co/ajax/contact@ash-financial.com', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(payload)
          })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
            .then(function (res) {
              if (!res.ok || res.data.success === 'false' || res.data.success === false) {
                throw new Error(res.data.message || 'Send failed');
              }
              try { localStorage.removeItem(KEY); } catch (err) { /* ignore */ }
              card.style.display = 'none';
              doneBox.style.display = 'block';
              doneBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
            })
            .catch(function () {
              errBox.innerHTML = '⚠️ We could not send your intake just now. Please email the details to <a href="mailto:contact@ash-financial.com?subject=Client%20Intake" style="color:#8f0a1f;text-decoration:underline;">contact@ash-financial.com</a> and we will pick it up from there.';
              errBox.style.display = 'block';
            })
            .finally(function () {
              sending = false;
              nextBtn.disabled = false;
              nextBtn.textContent = 'Submit Intake';
            });
        }

        nextBtn.addEventListener('click', function () {
          if (!validate(cur)) { return; }
          if (cur === steps.length - 1) { save(); submit(); return; }
          var n = cur + 1;
          if (n === 2 && !hasDetails()) { n = 3; }
          cur = n;
          save();
          render();
          card.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        backBtn.addEventListener('click', function () {
          var p = cur - 1;
          if (p === 2 && !hasDetails()) { p = 1; }
          if (p < 0) { p = 0; }
          cur = p;
          save();
          render();
          card.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        all('input, select, textarea').forEach(function (e) {
          e.addEventListener('change', save);
          e.addEventListener('input', save);
        });

        restore();
        if (cur === 2 && !hasDetails()) { cur = 1; }
        render();
      })();

      // === QUICK MESSAGE TOGGLE (short form hidden under the wizard) ===
      (function () {
        var link = document.getElementById('quickMsgToggle');
        var box = document.getElementById('quickMsg');
        if (!link || !box) { return; }
        link.addEventListener('click', function (e) {
          e.preventDefault();
          var open = box.style.display !== 'none';
          box.style.display = open ? 'none' : 'block';
          link.textContent = open ? 'Prefer to just send a quick message?' : 'Hide the quick message form';
          if (!open) {
            var f = document.getElementById('fname');
            if (f) { f.focus({ preventScroll: true }); }
            box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      })();

      document.getElementById('contactForm').addEventListener('submit', submitForm);
    </script>
</body>
</html>