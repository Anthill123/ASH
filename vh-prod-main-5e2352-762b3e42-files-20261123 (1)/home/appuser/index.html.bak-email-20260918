    <style>
      :root {
        --brand: #C8102E;
        --brand-dark: #a00d24;
        --dark: #0a0a0a;
        --light: #f5f5f5;
        --muted: #777777;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        font-family: 'Inter', sans-serif;
        color: #333;
        overflow-x: hidden;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Montserrat', sans-serif;
      }

      /* NAV */
      .nav-wrap {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 1000;
        background: #fff;
        transition: box-shadow 0.3s ease;
      }
      .nav-wrap.scrolled {
        box-shadow: 0 2px 16px rgba(0,0,0,0.10);
      }
      .nav-link {
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #444;
        text-decoration: none;
        transition: color 0.2s;
        cursor: pointer;
      }
      .nav-link:hover { color: var(--brand); }

      /* LOGO */
      .logo-bar-top {
        width: 40px; height: 3px;
        background: #0a0a0a;
        margin-bottom: 2px;
      }
      .logo-text-ash {
        font-family: 'Montserrat', sans-serif;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: 4px;
        color: #0a0a0a;
        line-height: 1;
      }
      .logo-red-bars {
        display: flex;
        justify-content: space-between;
        width: 40px;
        margin-top: 1px;
      }
      .logo-red-bar {
        width: 14px; height: 2px;
        background: var(--brand);
      }
      .logo-financial {
        font-family: 'Montserrat', sans-serif;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 3.5px;
        text-transform: uppercase;
        color: #0a0a0a;
        margin-top: 1px;
      }

      /* HERO */
      .hero-section {
        min-height: 100vh;
        background-color: #0a0a0a;
        background-image: repeating-linear-gradient(
          45deg,
          transparent,
          transparent 35px,
          rgba(255,255,255,0.015) 35px,
          rgba(255,255,255,0.015) 36px
        );
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        position: relative;
      }

      .hero-content {
        animation: heroFadeIn 1.2s ease forwards;
        opacity: 0;
      }
      @keyframes heroFadeIn {
        to { opacity: 1; transform: translateY(0); }
        from { opacity: 0; transform: translateY(20px); }
      }

      .btn-primary {
        display: inline-block;
        background: var(--brand);
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 15px 34px;
        border: 2px solid var(--brand);
        border-radius: 2px;
        cursor: pointer;
        transition: all 0.25s ease;
        text-decoration: none;
      }
      .btn-primary:hover {
        background: var(--brand-dark);
        border-color: var(--brand-dark);
      }

      /* BTN-RED */
      .btn-red {
        background: #C8102E;
        color: #fff;
        padding: 14px 34px;
        border: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s;
        text-decoration: none;
        display: inline-block;
      }
      .btn-red:hover {
        background: #a00d24;
      }

      /* BTN-OUTLINE */
      .btn-outline {
        background: transparent;
        color: #fff;
        padding: 14px 34px;
        border: 2px solid #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
      }
      .btn-outline:hover {
        background: #fff;
        color: #0a0a0a;
      }

      /* BTN-WHITE */
      .btn-white {
        background: transparent;
        color: #fff;
        padding: 14px 40px;
        border: 2px solid #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
      }
      .btn-white:hover {
        background: #fff;
        color: #C8102E;
      }

      /* SECTION FADE-IN */
      .fade-section {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease, transform 0.7s ease;
      }
      .fade-section.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* SERVICE CARD */
      .service-card {
        background: #fff;
        border-top: 3px solid var(--brand);
        padding: 28px;
        border-radius: 4px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }
      .service-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 28px rgba(0,0,0,0.13);
      }

      /* BOOK COVER */
      .book-cover {
        width: 180px;
        height: 270px;
        border-radius: 3px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 18px;
        flex-shrink: 0;
        position: relative;
      }

      /* MOBILE MENU */
      .mobile-menu {
        position: fixed;
        inset: 0;
        background: #fff;
        z-index: 9999;
        display: none;
        flex-direction: column;
        padding: 24px;
      }
      .mobile-menu.open {
        display: flex;
      }
      .mobile-menu .nav-link {
        font-size: 18px;
        padding: 16px 0;
        border-bottom: 1px solid #eee;
      }

      /* CTA */
      .btn-outline-white {
        display: inline-block;
        background: transparent;
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 15px 40px;
        border: 2px solid #fff;
        border-radius: 2px;
        cursor: pointer;
        transition: all 0.25s ease;
        text-decoration: none;
      }
      .btn-outline-white:hover {
        background: #fff;
        color: var(--brand);
      }

      /* VALUE CARD */
      .value-card {
        padding: 20px 0;
      }
      .value-card-bar {
        width: 30px; height: 3px;
        background: var(--brand);
        margin-bottom: 12px;
      }

      /* FOOTER LINK */
      .footer-link {
        color: #ccc;
        text-decoration: none;
        font-size: 13px;
        transition: color 0.2s;
        display: block;
        padding: 3px 0;
        cursor: pointer;
      }
      .footer-link:hover { color: var(--brand); }

      /* SECTION LABELS */
      .section-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--brand);
        margin-bottom: 14px;
      }

      /* CONTACT SECTION */
      #contact { background: #C8102E; padding: 80px 60px; }
      .contact-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; }
      .contact-left h2 { font-family: 'Montserrat', sans-serif; font-size: 32px; font-weight: 800; color: #fff; margin: 14px 0 16px; line-height: 1.2; }
      .contact-left p { font-size: 15px; color: rgba(255,255,255,0.8); line-height: 1.8; margin-bottom: 30px; }
      .contact-info { display: flex; flex-direction: column; gap: 14px; }
      .contact-info-item { display: flex; flex-direction: column; }
      .contact-info-label { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 3px; }
      .contact-info-item a, .contact-info-item span { font-size: 14px; color: #fff; text-decoration: none; }
      .contact-info-item a:hover { text-decoration: underline; }
      .contact-right { background: #fff; padding: 40px; border-radius: 2px; }
      .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .form-group { display: flex; flex-direction: column; margin-bottom: 18px; }
      .form-group label { font-size: 11px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #333; margin-bottom: 7px; font-family: 'Montserrat', sans-serif; }
      .form-group input, .form-group select, .form-group textarea { border: 1px solid #ddd; padding: 11px 14px; font-size: 14px; font-family: 'Inter', sans-serif; color: #111; outline: none; border-radius: 2px; transition: border-color 0.2s; background: #fafafa; }
      .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: #C8102E; background: #fff; }
      .form-group textarea { resize: vertical; }
      .form-submit { width: 100%; background: #C8102E; color: #fff; border: none; padding: 14px; font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; transition: background 0.2s; }
      .form-submit:hover { background: #a00d24; }

      /* COMING SOON BADGE */
      .badge-coming-soon {
        display: inline-block;
        background: transparent;
        border: 2px solid #c9a84c;
        color: #c9a84c;
        padding: 10px 24px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-top: 10px;
      }

      /* BOOKS GRID */
      .books-grid {
        max-width: 900px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 50px;
        justify-items: center;
      }
      @media (max-width: 768px) {
        .books-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 900px) { .contact-inner { grid-template-columns: 1fr; gap: 40px; } .form-row { grid-template-columns: 1fr; } }
      @media (max-width: 600px) { #contact { padding: 60px 24px; } .contact-right { padding: 24px; } }
    </style>
</head>
